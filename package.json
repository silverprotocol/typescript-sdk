{
  "name": "@silverprotocol/typescript-sdk",
  "private": true,
  "version": "0.0.0",
  "description": "TypeScript SDK for AgJSON \u2014 normalizers from agent frameworks to the typed agent<->client transport.",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "e2e:replay": "vitest run packages/e2e",
    "e2e:capture": "vitest run packages/e2e/src/capture-cli.test.ts",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "spec-drift": "node scripts/check-spec-drift.mjs",
    "spec-drift:self-test": "node scripts/check-spec-drift.mjs --self-test",
    "api-surface": "node scripts/check-api-surface.mjs",
    "fixture-drift": "node scripts/check-fixture-drift.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  }
}
